# ── Frontend Dockerfile ───────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci --frozen-lockfile

COPY frontend/ .

# Build with production API URL from build arg
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ── Production stage (serve with nginx) ──────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config to handle React SPA routing
RUN printf 'server {\n\
  listen 80;\n\
  client_max_body_size 50M;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / { try_files $uri $uri/ /index.html; }\n\
  location /auth { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /query { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /history { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /inventory { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /users { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /health { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
  location /tts { proxy_pass http://backend:8000; proxy_set_header Host $host; }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s \
  CMD wget -q --spider http://localhost/ || exit 1
