# Copy this file to .env and fill in local values.
# Real environment files are ignored by Git and must never be committed.

# Required: generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL identity used by Docker Compose and local development.
POSTGRES_USER=stocksync
POSTGRES_PASSWORD=stocksync_password
POSTGRES_DB=stocksync
DATABASE_URL=postgresql://stocksync:stocksync_password@localhost:5433/stocksync

ACCESS_TOKEN_EXPIRE_MINUTES=60
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# Required to enable POST /query.
GROQ_API_KEY=

# ── Intent pipeline tuning ───────────────────────────────────────────────────
# Model override. Leave unset to use the provider default.
# LLM_MODEL=openai/gpt-oss-20b

# Seconds allowed for one intent-extraction call before it is abandoned.
LLM_INTENT_TIMEOUT=30

# Follow-up questions asked before the assistant asks the user to restate.
LLM_MAX_CLARIFICATIONS=3

# Rollback switch: set to false to route requests through the legacy
# deterministic regex router instead of LLM intent extraction.
USE_LLM_INTENT=true

# Model/tool loop iterations. Applies only to the legacy rollback path.
LLM_MAX_TURNS=10

# Optional ElevenLabs text-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Standalone MCP HTTP settings. FastAPI forces its MCP child to stdio.
MCP_HOST=0.0.0.0
MCP_PORT=8001
# MCP_TRANSPORT=http

# VITE_API_URL belongs in frontend/.env.local, not in this backend file.
