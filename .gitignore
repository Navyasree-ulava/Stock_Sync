# ── Secrets and local environment ────────────────────────────────────────────
# Templates stay tracked; real values never do.
.env
.env.*
!.env.example
!**/.env.example

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
downloads/
.venv/
venv/
ENV/
env/

# ── Tests and coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
/frontend/dist/
/.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Local databases and logs ─────────────────────────────────────────────────
*.log
*.db
*.sqlite
*.sqlite3
*.sql

# ── Large or sensitive datasets (keep out of Git; supply your own) ──────────
backend/dataset.csv
backend/Grocery_Inventory_and_Sales_Dataset.csv
backend/inventory_1000.csv

# ── Docker ───────────────────────────────────────────────────────────────────
**/docker-compose.override.yml
**/docker-compose.*.yml
docker-compose.override.yml
docker-compose.*.yml
Dockerfile.*.local

# ── Agent and editor scratch space ───────────────────────────────────────────
.agent/
.claude/
scratch/
.vscode/
.idea/
.history/

# ── OS metadata ──────────────────────────────────────────────────────────────
